{
  "name": "coding-map-skill",
  "version": "1.0.0",
  "description": "Agent skill for interactive, offline code maps",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "vendor": "node scripts/bundle-mermaid.mjs",
